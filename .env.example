# SMTP-gegevens om de wekelijkse e-mail te versturen.
# Voor Gmail: zet 2FA aan en maak een "app-wachtwoord" op https://myaccount.google.com/apppasswords
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=jouw.adres@gmail.com
SMTP_PASS=app-wachtwoord

# Afzender- en ontvangeradres van de folder
MAIL_FROM="Aanbiedingenfolder <jouw.adres@gmail.com>"
MAIL_TO=jouw.adres@gmail.com

# Wanneer de wekelijkse e-mail verstuurd wordt (cron-syntax, standaard: elke maandag 08:00)
CRON_SCHEMA="0 8 * * 1"
